{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Honeycomb",
  "version": "0.3.1",
  "identifier": "app.honeycomb",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Honeycomb",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "nsis"
    ],
    "publisher": "Honeycomb",
    "homepage": "https://github.com/Gingerbreadfork/honeycomb",
    "category": "Healthcare and Fitness",
    "shortDescription": "A calm blood glucose journal",
    "longDescription": "Honeycomb is a fast, calm blood glucose journal. Readings are kept in a plain CSV file you own, with charts, statistics and a printable report for your doctor.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "honeycomb.desktop"
      },
      "rpm": {
        "desktopTemplate": "honeycomb.desktop"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBNTcwN0I0NTEyMzQ5RTAKUldUZ1NTTlJ0QWRYbXI2ckc4OXN1Zml5cXJtR1lsUHk1YlZXS2JWM0poSlUvSkJYZ3cvdDVGVWkK",
      "endpoints": [
        "https://github.com/Gingerbreadfork/honeycomb/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
